@{
    ViewData["Title"] = "Cú pháp Razor";
}
<h1>@ViewData["Title"]</h1>
<hr/>
@{
    var total = 7500;
    var myMessage = "Ban la nhat";
}
<p> Tai khoan cua ban: $ @total</p>
<p> @myMessage</p>

<h2>Cấu trúc IF...</h2>
<hr/>
    @if(total > 5000)
    {
        <p> Toi ga lam</p>
    }
    else if (total > 2000)
    {
        <p>May thg ga</p>
    }
    else
    {
        <p>hẹ hẹ hẹ</p>
    }

<h2>Cấu trúc For...</h2>
@for (int i = 0; i < 10; i++)
{
    if (i % 2 == 0)

    {
        <span class="btn btn-danger">@i</span>

    }
    else
    {
        <span class="btn btn-success">@i</span>
    }
}

<h2>Mảng</h2>
@{
    string[] myArray = { "1.jpg", "2.jpg", "3.jpg", "4.jpg", "5.jpg" };
}
@foreach (var item in myArray)
{
    <img src="~/images/@item" width="150" height="150" />
}