@model IEnumerable<PttLesson07Models.Models.DataModels.PttMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<div class="card p-3">
    <h1>@ViewData["Title"]</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary my-1">Thêm mới</a>
    </p>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.PttMemberId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PttUserName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PttPassword)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PttFullName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PttEmail)
                </th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.PttMemberId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PttUserName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PttPassword)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PttFullName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PttEmail)
                    </td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                        @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                        @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>