@model Ptt2410900082_exam.Models.PttEmployee

@{
    ViewData["Title"] = "Xoá nhân viên";
}

<h2 class="mb-3 text-danger">Xác nhận xoá nhân viên</h2>

<div class="card border-danger shadow-sm" style="max-width: 600px;">
    <div class="card-body">
        <p class="text-danger fw-bold">Bạn có chắc chắn muốn xoá nhân viên này không?</p>

        <dl class="row mb-0">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PttName)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.PttName)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PttGender)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.PttGender)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PttBirthday)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.PttBirthday)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PttEmail)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.PttEmail)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PttPhone)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.PttPhone)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PttActive)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.PttActive)</dd>
        </dl>

        <form asp-action="Delete" class="mt-3 d-flex gap-2">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Xoá" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
        </form>
    </div>
</div>