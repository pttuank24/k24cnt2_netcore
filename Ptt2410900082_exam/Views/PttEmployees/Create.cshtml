@model Ptt2410900082_exam.Models.PttEmployee

@{
    ViewData["Title"] = "Thêm nhân viên";
}

<h2 class="mb-3">Thêm nhân viên mới</h2>

<div class="card shadow-sm" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="PttName" class="form-label fw-bold"></label>
                <input asp-for="PttName" class="form-control" />
                <span asp-validation-for="PttName" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="PttGender" class="form-check-input" />
                <label asp-for="PttGender" class="form-check-label fw-bold"></label>
                <span asp-validation-for="PttGender" class="text-danger d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PttBirthday" class="form-label fw-bold"></label>
                <input asp-for="PttBirthday" class="form-control" type="date" />
                <span asp-validation-for="PttBirthday" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PttEmail" class="form-label fw-bold"></label>
                <input asp-for="PttEmail" class="form-control" />
                <span asp-validation-for="PttEmail" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PttPhone" class="form-label fw-bold"></label>
                <input asp-for="PttPhone" class="form-control" />
                <span asp-validation-for="PttPhone" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="PttActive" class="form-check-input" />
                <label asp-for="PttActive" class="form-check-label fw-bold"></label>
                <span asp-validation-for="PttActive" class="text-danger d-block"></span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <input type="submit" value="Lưu" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
            </div>
        </form>
    </div>
</div>