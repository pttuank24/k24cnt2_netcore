@model PttLesson09Annotation.Models.DataViewModels.PttMemberRegister

@{
    ViewData["Title"] = "Thanh vien moi";
}

<h1>@ViewData["Title"]</h1>

<h4>PttMemberRegister</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
