@model PttLesson08Models.Models.PttMember

@{
    ViewData["Title"] = "Thêm mới thành viên";
}
<form asp-action="PttCreate" method="post">
    <div class="card p-3">
        <div class="card-header">
            <h1>@ViewData["Title"]</h1>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="PttMemberId" class="control-label"></label>
                        <input asp-for="PttMemberId" class="form-control" />
                        <span asp-validation-for="PttMemberId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PttUserName" class="control-label"></label>
                        <input asp-for="PttUserName" class="form-control" />
                        <span asp-validation-for="PttUserName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PttPassword" class="control-label"></label>
                        <input asp-for="PttPassword" class="form-control" />
                        <span asp-validation-for="PttPassword" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PttFullName" class="control-label"></label>
                        <input asp-for="PttFullName" class="form-control" />
                        <span asp-validation-for="PttFullName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PttEmail" class="control-label"></label>
                        <input asp-for="PttEmail" class="form-control" />
                        <span asp-validation-for="PttEmail" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer">
            <div class="form-group">
                <input type="submit" value="Ghi lại" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </div>
    </div>
</form>